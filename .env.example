# Copie para .env ou exporte a variável antes de usar o Tradex.
# Crie sua chave em https://console.mistral.ai
MISTRAL_API_KEY=sua-chave-aqui

# Opcional: token gratuito da brapi.dev para a Ronda diária (https://brapi.dev)
# Sem token, a Ronda funciona só com PETR4, VALE3, ITUB4, MGLU3 e cripto (OKX).
BRAPI_TOKEN=
